<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect all requests to the "public" folder if not already in it
    RewriteCond %{REQUEST_URI} !^/public/
    
    # Check if the requested file/directory actually exists in the root (to serve assets like images/css directly from root)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite the URL internally to the public folder
    RewriteRule ^(.*)$ public/$1 [L]
    
    # Handle the front controller within the "public" folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ api/index.php [L]
</IfModule>
